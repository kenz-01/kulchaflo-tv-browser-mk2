{
  "manifest_version": 2,
  "name": "Kulcha Flo GV Media Observer",
  "version": "1.3",
  "description": "Collects generic page media evidence for MkII-GV",
  "browser_specific_settings": {
    "gecko": {
      "id": "gv-media@kulchaflo.tv"
    }
  },
  "permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["candidate-ranking.js", "content.js", "zns-streamcomedia-helper.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://telesistema11.com.do/en-vivo*",
        "https://www.telesistema11.com.do/en-vivo*"
      ],
      "js": ["telesistema-lazy-frame-helper.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
