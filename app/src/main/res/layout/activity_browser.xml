<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/browser_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kf_background"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <FrameLayout
        android:id="@+id/tab_host_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kf_background" />

    <FrameLayout
        android:id="@+id/fullscreen_host_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kf_background"
        android:visibility="gone" />

    <com.kulchaflo.tv.mk2.promotedmedia.PromotedMediaHostView
        android:id="@+id/promoted_media_host_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/chrome_placeholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:background="@drawable/chrome_scrim"
        android:visibility="gone">

        <TextView
            android:id="@+id/chrome_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kulcha Flo TV MkII"
            android:textColor="@color/kf_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/tabs_overlay_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <com.kulchaflo.tv.mk2.ui.pointer.PointerOverlayView
        android:id="@+id/pointer_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

    <FrameLayout
        android:id="@+id/startup_loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/kf_background" />

</FrameLayout>
