<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:antialias="true"
            android:gravity="center"
            android:src="@drawable/kf_hero_banner_bg" />
    </item>

    <item android:left="20dp" android:top="12dp" android:right="300dp" android:bottom="12dp">
        <scale
            android:gravity="left|center_vertical"
            android:scaleWidth="42%"
            android:scaleHeight="88%">
            <bitmap
                android:antialias="true"
                android:gravity="center"
                android:src="@drawable/kf_brand_badge" />
        </scale>
    </item>
</layer-list>
