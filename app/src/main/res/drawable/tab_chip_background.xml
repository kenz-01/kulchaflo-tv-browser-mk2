<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/kf_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/kf_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/kf_surface_elevated" />
            <stroke
                android:width="1dp"
                android:color="@color/kf_accent" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/kf_surface" />
            <stroke
                android:width="1dp"
                android:color="@color/kf_surface_overlay_border" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
