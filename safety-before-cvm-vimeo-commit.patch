+        if (!isTttLiveSurfaceUrl(pageUrl)) {
+            return
+        }
+        val now = SystemClock.uptimeMillis()
+        val lastDispatch = tttConsentLastDispatchMsBySession[session] ?: 0L
+        if (now - lastDispatch < 1800L) {
+            return
+        }
